+/* EV3 mechanisms. Apache-2.0. */
+#pragma once
+#include <box2d/box2d.h>
+#include <array>
+#include <vector>
+#include "twoDModel/engine/model/gripperGeometry.h"
+namespace twoDModel {
+namespace model {
+namespace physics {
+namespace parts {
+class Box2DGripper
+{
+public:
+	Box2DGripper(b2WorldId world, b2BodyId robot)
+		: mWorld(world)
+		, mRobot(robot)
+	{
+	}
+	~Box2DGripper();
+	Box2DGripper(const Box2DGripper &) = delete;
+	Box2DGripper &operator=(const Box2DGripper &) = delete;
+	void clear();
+	void configure(const gripper::Configuration &, double opening, double width, double height);
+	void drive(double motorDegreesPerSecond);
+	double sample(); // Actual motor travel since the preceding sample.
+	double opening(int side = 0) const
+	{
+		return mOpening[side];
+	}
+	void tryCapture(const std::vector<b2BodyId> &, bool closing);
+	void release();
+	bool holding() const;
+
+private:
+	bool touches(b2BodyId, int) const;
+	b2WorldId mWorld;
+	b2BodyId mRobot;
+	gripper::Configuration mConfig;
+	std::vector<b2ShapeId> mFixed;
+	std::array<std::vector<b2ShapeId>, 2> mShapes;
+	std::array<b2BodyId, 2> mBodies {{b2_nullBodyId, b2_nullBodyId}};
+	std::array<b2JointId, 2> mJoints {{b2_nullJointId, b2_nullJointId}};
+	std::array<double, 2> mOpening {{25, 25}}, mLast {{0, 0}};
+	b2JointId mGripJoint = b2_nullJointId;
+	b2BodyId mHeldBody = b2_nullBodyId;
+};
+}
+}
+}
+}
