diff --git a/qrtest/ev3Gripper/physicsTests.cpp b/qrtest/ev3Gripper/physicsTests.cpp
new file mode 100644
index 0000000..bdab749
--- /dev/null
+++ b/qrtest/ev3Gripper/physicsTests.cpp
@@ -0,0 +1,174 @@
+/* EV3 mechanisms regression tests. Apache-2.0. */
+#ifdef NDEBUG
+#	undef NDEBUG
+#endif
+#include "box2DGripper.h"
+#include <cassert>
+#include <cmath>
+#include <iostream>
+using namespace twoDModel::model;
+using twoDModel::model::physics::parts::Box2DGripper;
+struct World {
+	b2WorldId id;
+	b2BodyId robot;
+	World()
+	{
+		b2SetLengthUnitsPerMeter(.1f);
+		auto w = b2DefaultWorldDef();
+		w.gravity = {0, 0};
+		id = b2CreateWorld(&w);
+		auto b = b2DefaultBodyDef();
+		robot = b2CreateBody(id, &b);
+	}
+	~World()
+	{
+		b2DestroyWorld(id);
+	}
+	b2BodyId ball(float x, float y, float radius, b2BodyType type = b2_dynamicBody)
+	{
+		auto b = b2DefaultBodyDef();
+		b.type = type;
+		b.position = {x, y};
+		b.linearDamping = 4;
+		b.angularDamping = 4;
+		auto body = b2CreateBody(id, &b);
+		auto s = b2DefaultShapeDef();
+		s.density = 100;
+		auto c = b2Circle {{0, 0}, radius};
+		b2CreateCircleShape(body, &s, &c);
+		return body;
+	}
+	void step(Box2DGripper &g, double speed, const std::vector<b2BodyId> &objects = {})
+	{
+		g.drive(speed);
+		b2World_Step(id, 1.f / 240, 8);
+		g.sample();
+		g.tryCapture(objects, speed < 0);
+	}
+};
+int main()
+{
+	gripper::Configuration c;
+	c.enabled = true;
+	assert(c.valid());
+	double a = 25;
+	gripper::advance(a, 10000, c, false);
+	assert(a == 25);
+	gripper::advance(a, -10000, c, false);
+	assert(a == gripper::minimumOpening);
+	a = 10;
+	assert(gripper::advance(a, -30, c, true) == 0 && a == 10);
+	for (int k = 0; k <= 5; ++k) {
+		c.kind = k;
+		assert(!gripper::geometry(c, 25, .18, .18).empty());
+		if (k >= gripper::Small) {
+			auto area = [](const gripper::Geometry &geometry) {
+				double result = 0;
+				for (auto poly : geometry) {
+					double a = 0;
+					for (size_t i = 0; i < poly.size(); ++i) {
+						auto p = poly[i], q = poly[(i + 1) % poly.size()];
+						a += p.x * q.y - q.x * p.y;
+					}
+					result += std::abs(a) / 2;
+				}
+				return result;
+			};
+			assert(std::abs(area(gripper::fixedGeometry(k)) - area(gripper::geometry(c, 0, 18, 18)))
+			        < 1e-6);
+		}
+	}
+	c.kind = gripper::Gripper;
+	{
+		World w;
+		Box2DGripper g(w.id, w.robot);
+		g.configure(c, 25, .18, .18);
+		auto ball = w.ball(.145f, 0, .025f);
+		for (int i = 0; i < 2000 && !g.holding(); ++i)
+			w.step(g, -120, {ball});
+		std::cout << "capture " << g.holding() << " angles " << g.opening(0) << "," << g.opening(1) << "\n";
+		assert(g.holding());
+		assert(g.opening(0) > -35 && g.opening(1) > -35);
+		const auto before = b2Body_GetPosition(ball);
+		b2Body_SetType(w.robot, b2_kinematicBody);
+		for (int i = 0; i < 120; ++i) {
+			b2Body_SetLinearVelocity(w.robot, {.1f, 0});
+			w.step(g, 0, {ball});
+		}
+		assert(b2Body_GetPosition(ball).x > before.x + .03f);
+		g.drive(100);
+		assert(!g.holding());
+		assert(b2Body_GetJointCount(ball) == 0);
+		g.configure(c, 25, .18, .18);
+		assert(std::abs(g.opening() - 25) < 1e-9);
+		assert(!g.holding());
+	}
+	{
+		World w;
+		Box2DGripper g(w.id, w.robot);
+		g.configure(c, 25, .18, .18);
+		auto wall = w.ball(.145f, -.025f, .025f, b2_staticBody);
+		for (int i = 0; i < 1500; ++i)
+			w.step(g, -180, {});
+		assert(!g.holding());
+		std::cout << "wall angles " << g.opening(0) << "," << g.opening(1) << "\n";
+		assert(std::max(g.opening(0), g.opening(1)) > -30);
+		assert(std::min(g.opening(0), g.opening(1)) > -37);
+		const int n = b2Body_GetContactCapacity(wall);
+		std::vector<b2ContactData> data(n);
+		const int count = b2Body_GetContactData(wall, data.data(), n);
+		for (int i = 0; i < count; ++i)
+			for (int j = 0; j < data[i].manifold.pointCount; ++j)
+				assert(data[i].manifold.points[j].separation > -.004f);
+	}
+	{
+		World w;
+		Box2DGripper g(w.id, w.robot);
+		g.configure(c, 25, .18, .18);
+		auto ball = w.ball(.145f, 0, .025f);
+		for (int i = 0; i < 2000 && !g.holding(); ++i)
+			w.step(g, -120, {ball});
+		assert(g.holding());
+		b2DestroyBody(ball);
+		assert(!g.holding());
+		g.release();
+		w.step(g, 0, {});
+	}
+	{
+		World w;
+		Box2DGripper g(w.id, w.robot);
+		g.configure(c, 25, .18, .18);
+		auto oneSide = w.ball(.15f, .08f, .015f);
+		for (int i = 0; i < 30; ++i)
+			w.step(g, 0, {oneSide});
+		g.tryCapture({oneSide}, true);
+		assert(!g.holding());
+	}
+	for (int length = 0; length < 4; ++length) {
+		World w;
+		Box2DGripper g(w.id, w.robot);
+		c.kind = gripper::Kicker;
+		c.kickerLength = length;
+		g.configure(c, 0, .18, .18);
+		double encoder = 0;
+		for (int i = 0; i < 2400; ++i) {
+			g.drive(360);
+			b2World_Step(w.id, 1.f / 240, 8);
+			encoder += g.sample();
+		}
+		std::cout << "kicker " << length << " turns " << encoder / 360 << "\n";
+		assert(encoder > 2500);
+		assert(g.opening() > 2500);
+	}
+	for (int k = gripper::Small; k <= gripper::Straight; ++k) {
+		World w;
+		Box2DGripper g(w.id, w.robot);
+		c.kind = k;
+		g.configure(c, 0, .18, .18);
+		assert(b2Body_GetShapeCount(w.robot) == static_cast<int>(gripper::geometry(c, 0, .18, .18).size()));
+		g.clear();
+		assert(b2Body_GetShapeCount(w.robot) == 0);
+	}
+	std::cout << "PASS: capture/carry/release, real hinge obstruction, no wall penetration, reset, deleted "
+		     "payload, four continuous kickers and all fixed claws\n";
+}
diff --git a/qrtest/ev3Gripper/serializationTests.cpp b/qrtest/ev3Gripper/serializationTests.cpp
new file mode 100644
index 0000000..7cc6c9a
--- /dev/null
+++ b/qrtest/ev3Gripper/serializationTests.cpp
@@ -0,0 +1,58 @@
+/* EV3 gripper prototype tests, Apache-2.0. */
+#ifdef NDEBUG
+#	undef NDEBUG
+#endif
+#include "twoDModel/engine/model/gripperSerialization.h"
+#include <cassert>
+#include <iostream>
+using namespace twoDModel::model::gripper;
+int main()
+{
+	QDomDocument doc;
+	assert(doc.setContent(QString("<robot/>")));
+	auto root = doc.documentElement();
+	assert(!deserialize(root).enabled);
+	Configuration expected;
+	expected.enabled = true;
+	expected.port = 3;
+	expected.x = .6;
+	expected.y = -.2;
+	expected.rotation = 90;
+	expected.length = 1.2;
+	expected.initialOpening = 12;
+	expected.travel = 360;
+	serialize(expected, root);
+	QDomDocument saved;
+	assert(saved.setContent(doc.toByteArray()));
+	auto value = deserialize(saved.documentElement());
+	assert(value.enabled && value.port == 3 && value.rotation == 90 && value.length == 1.2 && value.travel == 360
+	        && value.initialOpening == 12);
+	for (int kind = 0; kind <= 5; ++kind)
+		for (int length = 0; length < 4; ++length) {
+			QDomDocument d;
+			auto root = d.createElement("robot");
+			d.appendChild(root);
+			expected.kind = kind;
+			expected.kickerLength = length;
+			expected.maxOpening = 123;
+			serialize(expected, root);
+			const auto restored = deserialize(root);
+			assert(restored.enabled && restored.kind == kind && restored.kickerLength == length
+			        && restored.maxOpening == 123);
+		}
+	for (const auto &bad : {QString("<robot><gripper enabled='true' port=''/></robot>"),
+		     QString("<robot><gripper enabled='true' port='BLAH'/></robot>"),
+		     QString("<robot><gripper enabled='true' length='nan'/></robot>"),
+		     QString("<robot><gripper enabled='true' x='Infinity'/></robot>"),
+		     QString("<robot><gripper enabled='true' opening='-1'/></robot>"),
+		     QString("<robot><gripper enabled='true' travel='0'/></robot>"),
+		     QString("<robot><gripper enabled='true' kind='2.5'/></robot>"),
+		     QString("<robot><gripper enabled='true' maxOpening='181'/></robot>"),
+		     QString("<robot><gripper enabled='true' kickerLength='4'/></robot>")}) {
+		QDomDocument invalid;
+		assert(invalid.setContent(bad));
+		assert(!deserialize(invalid.documentElement()).enabled);
+	}
+	std::cout << "PASS: old field compatibility, XML roundtrip, invalid/empty port, NaN, infinity, end-stop and "
+		     "travel validation\n";
+}
