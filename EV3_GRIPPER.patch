+/* Apache-2.0. */
+#include "mechanismPanel.h"
+#include <QComboBox>
+#include <QDoubleSpinBox>
+#include <QLabel>
+#include <QVBoxLayout>
+#include <QSignalBlocker>
+#include <QIcon>
+#include "twoDModel/engine/model/timeline.h"
+using namespace twoDModel;
+QWidget *view::createMechanismPanel(model::RobotModel &robot, model::Timeline &timeline, QWidget *parent)
+{
+	auto *panel = new QWidget(parent);
+	panel->setMinimumHeight(220);
+	auto *layout = new QVBoxLayout(panel);
+	layout->setContentsMargins(6, 2, 8, 8);
+	auto *choice = new QComboBox(panel);
+	choice->setObjectName("mechanismChoice");
+	choice->setIconSize(QSize(76, 42));
+	choice->addItem(QStringLiteral("Без механизма"));
+	const QStringList names = {QStringLiteral("Малая клешня"), QStringLiteral("Большая клешня"),
+		QStringLiteral("Узкая клешня"), QStringLiteral("Прямая клешня"), QStringLiteral("Моторный захват"),
+		QStringLiteral("Пиналка — короткая"), QStringLiteral("Пиналка — средняя"),
+		QStringLiteral("Пиналка — длинная"), QStringLiteral("Пиналка — очень длинная")};
+	const QStringList images = {"claw-small.png", "claw-large.png", "claw-narrow.png", "claw-straight.png",
+		"beam-straight.png", "beam-angle.png", "kicker-medium.png", "kicker-long.png", "kicker-extra-long.png"};
+	for (int i = 0; i < names.size(); ++i)
+		choice->addItem(QIcon(":/mechanisms/" + images[i]), names[i]);
+	layout->addWidget(choice);
+	auto *label = new QLabel(QStringLiteral("Максимальное раскрытие"), panel);
+	layout->addWidget(label);
+	auto *opening = new QDoubleSpinBox(panel);
+	opening->setObjectName("mechanismOpening");
+	opening->setRange(0, 180);
+	opening->setDecimals(0);
+	opening->setSuffix(QStringLiteral("°"));
+	layout->addWidget(opening);
+	auto *help = new QLabel(QStringLiteral("Перетащите механизм мышью. Для поворота потяните синюю стрелку. Порт "
+					       "мотора — правой кнопкой по механизму."),
+		panel);
+	help->setWordWrap(true);
+	layout->addWidget(help);
+	auto sync = [&robot, &timeline, choice, opening, label, panel]() {
+		const auto &c = robot.gripperConfiguration();
+		const QSignalBlocker b1(choice), b2(opening);
+		const int index = !c.enabled                          ? 0
+		                  : c.kind == model::gripper::Gripper ? 5
+		                  : c.kind == model::gripper::Kicker  ? 6 + c.kickerLength
+		                                                      : c.kind - 1;
+		choice->setCurrentIndex(index);
+		opening->setValue(c.maxOpening);
+		label->setVisible(c.enabled && c.kind == model::gripper::Gripper);
+		opening->setVisible(c.enabled && c.kind == model::gripper::Gripper);
+		panel->setEnabled(!timeline.isStarted());
+	};
+	QObject::connect(choice, QOverload<int>::of(&QComboBox::currentIndexChanged), panel, [&robot, sync](int index) {
+		auto c = robot.gripperConfiguration();
+		c.enabled = index != 0;
+		c.kind = index == 5 ? model::gripper::Gripper : index >= 6 ? model::gripper::Kicker : index + 1;
+		if (index == 0)
+			c.kind = model::gripper::Gripper;
+		c.kickerLength = index >= 6 ? index - 6 : 0;
+		c.initialOpening = c.kind == model::gripper::Gripper ? c.maxOpening / 2 : 0;
+		if (c.motorized())
+			for (int i = 0; i < 4; ++i) {
+				const QString name(QChar('A' + i));
+				if (robot.getPortInfoOnWheel(model::RobotModel::left).name() != name
+				        && robot.getPortInfoOnWheel(model::RobotModel::right).name() != name) {
+					c.port = i;
+					break;
+				}
+			}
+		robot.configureGripper(c);
+		sync();
+	});
+	QObject::connect(opening, QOverload<double>::of(&QDoubleSpinBox::valueChanged), panel, [&robot](double value) {
+		auto c = robot.gripperConfiguration();
+		c.maxOpening = value;
+		c.initialOpening = value / 2;
+		robot.configureGripper(c);
+	});
+	QObject::connect(&robot, &model::RobotModel::gripperChanged, panel, sync);
+	QObject::connect(&robot, &model::RobotModel::wheelOnPortChanged, panel,
+		[sync](model::RobotModel::WheelEnum, const kitBase::robotModel::PortInfo &) { sync(); });
+	QObject::connect(&timeline, &model::Timeline::started, panel, sync);
+	QObject::connect(&timeline, &model::Timeline::stopped, panel, sync);
+	sync();
+	return panel;
+}
