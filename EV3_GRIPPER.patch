+/* EV3 mechanisms editor. Apache-2.0. */
+#include "mechanismItem.h"
+#include <QPainter>
+#include <QPixmap>
+#include <QGraphicsScene>
+#include <QGraphicsSceneMouseEvent>
+#include <QGraphicsSceneContextMenuEvent>
+#include <QKeyEvent>
+#include <QMenu>
+#include "twoDModel/engine/model/twoDModelRobotParameters.h"
+#include "twoDModel/engine/model/timeline.h"
+using namespace twoDModel::view;
+using namespace twoDModel::model;
+namespace {
+QPixmap image(const char *name)
+{
+	return QPixmap(QString(":/mechanisms/") + name);
+}
+void sprite(QPainter *p, const char *name, double ax, double ay, double pitch)
+{
+	const auto pix = image(name);
+	p->drawPixmap(QRectF(-ax / pitch, -ay / pitch, pix.width() / pitch, pix.height() / pitch), pix,
+		QRectF(pix.rect()));
+}
+}
+MechanismItem::MechanismItem(RobotModel &model, QGraphicsItem *parent)
+	: QGraphicsItem(parent)
+	, mModel(model)
+{
+	setFlags(ItemIsSelectable | ItemIsFocusable);
+	setAcceptedMouseButtons(Qt::LeftButton | Qt::RightButton);
+	setZValue(8);
+	setCursor(Qt::OpenHandCursor);
+	refresh();
+	setToolTip(QStringLiteral(
+		"Перетащите мышью. Синяя стрелка — поворот. Правой кнопкой — порт мотора или удаление."));
+}
+bool MechanismItem::editingAllowed() const
+{
+	auto *timeline = dynamic_cast<Timeline *>(&mModel.info().timeline());
+	return !timeline || !timeline->isStarted();
+}
+QPointF MechanismItem::mount() const
+{
+	const auto &c = mModel.gripperConfiguration();
+	const auto size = mModel.parameters()->size();
+	return mModel.parameters()->robotCenter() + QPointF(c.x * size.width(), c.y * size.height());
+}
+QPointF MechanismItem::handle() const
+{
+	const auto &c = mModel.gripperConfiguration();
+	const auto p = gripper::rotate({0, -45}, c.rotation);
+	return mount() + QPointF(p.x, p.y);
+}
+void MechanismItem::refresh()
+{
+	prepareGeometryChange();
+	mShape = QPainterPath();
+	mShape.setFillRule(Qt::WindingFill);
+	const auto size = mModel.parameters()->size();
+	auto geometry = gripper::geometry(mModel.gripperConfiguration(), mModel.gripperJawOpening(0), size.width(),
+		size.height(), mModel.gripperJawOpening(1));
+	const auto base = gripper::baseGeometry(mModel.gripperConfiguration(), size.width(), size.height());
+	geometry.insert(geometry.end(), base.begin(), base.end());
+	for (const auto &poly : geometry) {
+		QPolygonF p;
+		for (auto v : poly)
+			p << QPointF(v.x, v.y) + mModel.parameters()->robotCenter();
+		mShape.addPolygon(p);
+		mShape.closeSubpath();
+	}
+	setVisible(mModel.gripperConfiguration().enabled);
+	update();
+}
+QRectF MechanismItem::boundingRect() const
+{
+	return mShape.boundingRect().united(QRectF(mount() - QPointF(56, 56), QSizeF(112, 112))).adjusted(-3, -3, 3, 3);
+}
+QPainterPath MechanismItem::shape() const
+{
+	auto p = mShape;
+	if (isSelected())
+		p.addEllipse(handle(), 11, 11);
+	p.addEllipse(mount(), 8, 8);
+	return p;
+}
+void MechanismItem::paint(QPainter *p, const QStyleOptionGraphicsItem *, QWidget *)
+{
+	const auto &c = mModel.gripperConfiguration();
+	if (!c.enabled)
+		return;
+	p->setRenderHint(QPainter::SmoothPixmapTransform);
+	p->setRenderHint(QPainter::Antialiasing);
+	p->save();
+	p->translate(mount());
+	p->rotate(c.rotation);
+	const double scale = mModel.parameters()->size().width() / 18;
+	p->scale(scale, scale);
+	if (c.kind == gripper::Gripper) {
+		p->setPen(QPen(QColor("#69737c"), .15));
+		p->setBrush(QColor("#bac2c8"));
+		p->drawRect(QRectF(-3, -2, 5, 4));
+		for (double y : {-5.5, -2.5}) {
+			p->save();
+			p->translate(.6, y);
+			p->rotate(90);
+			sprite(p, "beam-straight.png", 124, 450, 169);
+			p->restore();
+		}
+		for (int side = 0; side < 2; ++side) {
+			p->save();
+			p->translate(1, side ? 5.5 : -5.5);
+			p->rotate((side ? 1 : -1) * mModel.gripperJawOpening(side));
+			sprite(p, "beam-straight.png", 124, 450, 169);
+			p->restore();
+		}
+	} else if (c.kind == gripper::Kicker) {
+		p->setBrush(QColor("#bac2c8"));
+		p->drawRect(QRectF(-3, -2, 5, 4));
+		p->rotate(180 + mModel.gripperOpening());
+		static const char *names[] = {"beam-angle.png", "kicker-medium.png", "kicker-long.png",
+			"kicker-extra-long.png"};
+		const double anchors[][3] = {{1477, 541, 184}, {1565, 785, 150}, {1680, 390, 115}, {1775, 470, 100}};
+		if (c.kickerLength >= 2)
+			p->scale(1, -1);
+		auto a = anchors[c.kickerLength];
+		sprite(p, names[c.kickerLength], a[0], a[1], a[2]);
+	} else {
+		static const char *names[] = {"claw-small.png", "claw-large.png", "claw-narrow.png",
+			"claw-straight.png"};
+		const double anchors[][3] = {{803, 311, 81}, {800, 371, 78.7}, {774, 239, 104.5}, {1173, 715, 80}};
+		auto a = anchors[c.kind - 2];
+		p->rotate(-90 + (c.kind == gripper::Straight ? 180 : 0));
+		sprite(p, names[c.kind - 2], a[0], a[1], a[2]);
+	}
+	p->restore();
+	if (isSelected() && editingAllowed()) {
+		p->setBrush(Qt::NoBrush);
+		p->setPen(QPen(QColor("#3f9cff"), 1.5, Qt::DashLine));
+		p->drawPath(mShape);
+		p->setPen(QPen(QColor("#3f9cff"), 2));
+		p->drawLine(mount(), handle());
+		p->setBrush(QColor("#2679ce"));
+		p->drawEllipse(handle(), 9, 9);
+		p->setPen(Qt::white);
+		p->drawText(QRectF(handle() - QPointF(9, 10), QSizeF(18, 20)), Qt::AlignCenter, QStringLiteral("↻"));
+		if (c.motorized()) {
+			p->setPen(QColor("#3f9cff"));
+			p->drawText(mount() + QPointF(7, -7), QStringLiteral("Мотор ") + QChar('A' + c.port));
+		}
+	}
+}
+void MechanismItem::mousePressEvent(QGraphicsSceneMouseEvent *e)
+{
+	if (!editingAllowed()) {
+		e->accept();
+		return;
+	}
+	if (e->button() == Qt::RightButton) {
+		e->accept();
+		return;
+	}
+	const bool wasSelected = isSelected();
+	if (scene())
+		scene()->clearSelection();
+	parentItem()->setSelected(true);
+	setSelected(true);
+	setFocus();
+	mRotating = wasSelected && QLineF(e->pos(), handle()).length() < 14;
+	mDragOffset = e->pos() - mount();
+	setCursor(Qt::ClosedHandCursor);
+	e->accept();
+	update();
+}
+void MechanismItem::mouseMoveEvent(QGraphicsSceneMouseEvent *e)
+{
+	if (!editingAllowed()) {
+		e->accept();
+		return;
+	}
+	auto c = mModel.gripperConfiguration();
+	if (mRotating) {
+		const auto v = e->pos() - mount();
+		c.rotation = std::atan2(v.y(), v.x()) / gripper::radians + 90;
+		if (c.rotation > 180)
+			c.rotation -= 360;
+	} else {
+		const auto target = e->pos() - mDragOffset - mModel.parameters()->robotCenter();
+		const auto size = mModel.parameters()->size();
+		c.x = qBound(-4.0, target.x() / size.width(), 4.0);
+		c.y = qBound(-4.0, target.y() / size.height(), 4.0);
+	}
+	mModel.configureGripper(c);
+	e->accept();
+}
+void MechanismItem::mouseReleaseEvent(QGraphicsSceneMouseEvent *e)
+{
+	setCursor(Qt::OpenHandCursor);
+	e->accept();
+}
+void MechanismItem::contextMenuEvent(QGraphicsSceneContextMenuEvent *e)
+{
+	if (!editingAllowed()) {
+		e->accept();
+		return;
+	}
+	QMenu menu;
+	auto c = mModel.gripperConfiguration();
+	if (c.motorized()) {
+		auto *ports = menu.addMenu(QStringLiteral("Порт мотора"));
+		for (int i = 0; i < 4; ++i) {
+			const QString name(QChar('A' + i));
+			auto *a = ports->addAction(name);
+			a->setCheckable(true);
+			a->setChecked(c.port == i);
+			a->setEnabled(mModel.getPortInfoOnWheel(RobotModel::left).name() != name
+			              && mModel.getPortInfoOnWheel(RobotModel::right).name() != name);
+			QObject::connect(a, &QAction::triggered, [this, c, i]() mutable {
+				c.port = i;
+				mModel.configureGripper(c);
+			});
+		}
+	}
+	auto *remove = menu.addAction(QStringLiteral("Удалить механизм"));
+	if (menu.exec(e->screenPos()) == remove) {
+		c.enabled = false;
+		mModel.configureGripper(c);
+	}
+	e->accept();
+}
+void MechanismItem::keyPressEvent(QKeyEvent *e)
+{
+	if (isSelected() && editingAllowed() && (e->key() == Qt::Key_Delete || e->key() == Qt::Key_Backspace)) {
+		auto c = mModel.gripperConfiguration();
+		c.enabled = false;
+		mModel.configureGripper(c);
+		e->accept();
+		return;
+	}
+	QGraphicsItem::keyPressEvent(e);
+}
+
+void MechanismItem::removeMechanism()
+{
+	if (editingAllowed()) {
+		auto c = mModel.gripperConfiguration();
+		c.enabled = false;
+		mModel.configureGripper(c);
+	}
+}
