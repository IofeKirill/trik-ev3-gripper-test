+bool RobotModel::configureGripper(const gripper::Configuration &configuration)
+{
+	if (!configuration.valid() || (configuration.enabled && !info().supportsGripper()))
+		return false;
+	const PortInfo port(QString(QChar('A' + configuration.port)), output);
+	if (configuration.enabled
+	        && (getPortInfoOnWheel(left).name() == port.name() || getPortInfoOnWheel(right).name() == port.name()))
+		return false;
+	// Stop the previously assigned motor before replacing the mechanism.
+	for (auto it = mMotors.begin(); it != mMotors.end(); ++it)
+		if (it.key().name() == QString(QChar('A' + mGripper.port)))
+			it.value()->speed = 0;
+	mGripper = configuration;
+	mGripperOpening = mGripper.initialOpening;
+	++mGripperRevision;
+	if (mGripper.enabled)
+		mSettings->setRealisticPhysics(true);
+	Q_EMIT gripperChanged();
+	return true;
+}
+
+int RobotModel::gripperPower() const
+{
+	if (!mGripper.enabled || !onTheGround())
+		return 0;
+	for (auto it = mMotors.cbegin(); it != mMotors.cend(); ++it)
+		if (it.key().name() == QString(QChar('A' + mGripper.port)))
+			return it.value()->speed;
+	return 0;
+}
+
+void RobotModel::advanceGripper(qreal seconds, bool holding)
+{
+	if (!mGripper.enabled || !onTheGround() || !qIsFinite(seconds) || seconds <= 0)
+		return;
+	for (auto it = mMotors.begin(); it != mMotors.end(); ++it) {
+		if (it.key().name() != QString(QChar('A' + mGripper.port)))
+			continue;
+		auto &motor = *it.value();
+		const double commanded = motor.speed * parameters()->onePercentAngularVelocity() * 1000 * seconds;
+		const double actual = gripper::advance(mGripperOpening, commanded, mGripper, holding);
+		mTurnoverEngines[mMotorToEncoderPortMap[it.key()]] += actual;
+		if (motor.isUsed && motor.activeTimeType == DoByLimit
+		        && std::abs(mTurnoverEngines[mMotorToEncoderPortMap[it.key()]]) >= std::abs(motor.degrees)) {
+			motor.speed = 0;
+			motor.activeTimeType = End;
+		}
+		if (actual != 0)
+			Q_EMIT gripperChanged();
+		break;
+	}
+}
+
+void RobotModel::serializeGripper(QDomElement &robot) const
+{
+	if (info().supportsGripper())
+		gripper::serialize(mGripper, robot);
+}
+
+void RobotModel::deserializeGripper(const QDomElement &robot)
+{
+	auto configuration = gripper::deserialize(robot);
+	if (!configureGripper(configuration)) {
+		configuration.enabled = false;
+		configureGripper(configuration);
+	}
+}
