@@ -0,0 +1,106 @@
+/* EV3 gripper prototype, 2026. Apache-2.0. */
+#include "box2DGripper.h"
+#include <algorithm>
+using namespace twoDModel::model::physics::parts;
+Box2DGripper::~Box2DGripper()
+{
+	release();
+	for (auto &shape : mShapes)
+		if (b2Shape_IsValid(shape))
+			b2DestroyShape(shape, false);
+}
+bool Box2DGripper::holding() const
+{
+	return b2Joint_IsValid(mGripJoint) && b2Body_IsValid(mHeldBody);
+}
+void Box2DGripper::release()
+{
+	if (b2Joint_IsValid(mGripJoint))
+		b2DestroyJoint(mGripJoint);
+	mGripJoint = b2_nullJointId;
+	mHeldBody = b2_nullBodyId;
+}
+void Box2DGripper::setGeometry(const twoDModel::model::gripper::Geometry &geometry, bool enabled)
+{
+	if (!enabled) {
+		release();
+		for (auto &shape : mShapes) {
+			if (b2Shape_IsValid(shape))
+				b2DestroyShape(shape, false);
+			shape = b2_nullShapeId;
+		}
+		return;
+	}
+	for (int i = 0; i != 4; ++i) {
+		b2Vec2 points[4];
+		for (int j = 0; j != 4; ++j)
+			points[j] = {static_cast<float>(geometry[i][j].x), static_cast<float>(geometry[i][j].y)};
+		const auto hull = b2ComputeHull(points, 4);
+		if (hull.count < 3)
+			continue;
+		const auto polygon = b2MakePolygon(&hull, 0);
+		if (b2Shape_IsValid(mShapes[i])) {
+			// Avoid invalidating contacts when the motor is stopped or stalled.
+			const auto old = b2Shape_GetPolygon(mShapes[i]);
+			bool equal = old.count == polygon.count;
+			for (int j = 0; equal && j < old.count; ++j)
+				equal = b2DistanceSquared(old.vertices[j], polygon.vertices[j]) < 1e-12f;
+			if (!equal)
+				b2Shape_SetPolygon(mShapes[i], &polygon);
+		} else {
+			auto def = b2DefaultShapeDef();
+			def.density = 0;
+			def.material.friction = .9f;
+			def.material.restitution = 0;
+			mShapes[i] = b2CreatePolygonShape(mRobot, &def, &polygon);
+		}
+	}
+}
+bool Box2DGripper::touches(b2BodyId body, int side) const
+{
+	for (int i = side * 2; i < side * 2 + 2; ++i) {
+		if (!b2Shape_IsValid(mShapes[i]))
+			continue;
+		std::vector<b2ContactData> contacts(b2Shape_GetContactCapacity(mShapes[i]));
+		const int count =
+			b2Shape_GetContactData(mShapes[i], contacts.data(), static_cast<int>(contacts.size()));
+		for (int j = 0; j < count; ++j) {
+			const auto &c = contacts[j];
+			const auto other = B2_ID_EQUALS(c.shapeIdA, mShapes[i]) ? c.shapeIdB : c.shapeIdA;
+			// Box2D also reports speculative contacts. Require a touching manifold.
+			bool touching = false;
+			for (int k = 0; k < c.manifold.pointCount; ++k)
+				touching = touching || c.manifold.points[k].separation <= .001f;
+			if (touching && B2_ID_EQUALS(b2Shape_GetBody(other), body))
+				return true;
+		}
+	}
+	return false;
+}
+void Box2DGripper::tryCapture(const std::vector<b2BodyId> &objects, bool closing)
+{
+	if (holding() || !closing)
+		return;
+	for (auto body : objects) {
+		if (!b2Body_IsValid(body) || b2Body_GetType(body) != b2_dynamicBody || !b2Body_IsEnabled(body)
+		        || b2Body_GetJointCount(body) > 0)
+			continue;
+		if (!touches(body, 0) || !touches(body, 1))
+			continue;
+		auto joint = b2DefaultWeldJointDef();
+		joint.base.bodyIdA = mRobot;
+		joint.base.bodyIdB = body;
+		// Preserve the contact pose: no teleport and no snap to the gripper centre.
+		const auto anchor = b2Body_GetPosition(body);
+		joint.base.localFrameA.p = b2Body_GetLocalPoint(mRobot, anchor);
+		const auto angleA = b2Rot_GetAngle(b2Body_GetRotation(mRobot));
+		const auto angleB = b2Rot_GetAngle(b2Body_GetRotation(body));
+		joint.base.localFrameA.q = b2MakeRot(angleB - angleA);
+		joint.base.localFrameB.p = b2Vec2 {0, 0};
+		joint.base.localFrameB.q = b2MakeRot(0);
+		joint.base.collideConnected = false;
+		mGripJoint = b2CreateWeldJoint(mWorld, &joint);
+		mHeldBody = body;
+		return;
+	}
+}
