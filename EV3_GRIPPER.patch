+/* EV3 gripper prototype, 2026. Licensed under Apache-2.0, like TRIK Studio. */
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace twoDModel {
+namespace model {
+namespace gripper {
+struct Point {
+	double x, y;
+};
+using Quad = std::array<Point, 4>;
+using Geometry = std::array<Quad, 4>;
+struct Configuration {
+	bool enabled = false;
+	int port = 0; // A..D. Wheel ports cannot be used.
+	double x = .48, y = 0, rotation = 0, length = .70;
+	double initialOpening = 35, travel = 180;
+	bool valid() const
+	{
+		return port >= 0 && port < 4 && std::isfinite(x) && std::abs(x) <= 2 && std::isfinite(y)
+		       && std::abs(y) <= 2 && std::isfinite(rotation) && std::abs(rotation) <= 180
+		       && std::isfinite(length) && length >= .2 && length <= 2 && std::isfinite(initialOpening)
+		       && initialOpening >= 0 && initialOpening <= 55 && std::isfinite(travel) && travel >= 30
+		       && travel <= 1440;
+	}
+};
+constexpr double maximumOpening = 55;
+constexpr double radians = 3.14159265358979323846 / 180;
+inline Point rotate(Point p, double angle)
+{
+	const double c = std::cos(angle * radians), s = std::sin(angle * radians);
+	return {c * p.x - s * p.y, s * p.x + c * p.y};
+}
+// Coordinates relative to the centre of the robot body; shared by drawing and physics.
+inline Geometry geometry(const Configuration &config, double opening, double width, double height)
+{
+	Geometry result {};
+	const double length = config.length * width, thickness = .055 * height, hook = .11 * height;
+	for (int side = 0; side != 2; ++side) {
+		const double sign = side ? 1 : -1;
+		const Point root {config.x * width, config.y * height + sign * .19 * height};
+		Quad beam {
+			{{0, -thickness / 2}, {length, -thickness / 2}, {length, thickness / 2}, {0, thickness / 2}}};
+		const double end = -sign * hook;
+		Quad tip {{{length - thickness / 2, std::min(0.0, end)}, {length + thickness / 2, std::min(0.0, end)},
+			{length + thickness / 2, std::max(0.0, end)}, {length - thickness / 2, std::max(0.0, end)}}};
+		for (int part = 0; part != 2; ++part) {
+			Quad q = part ? tip : beam;
+			for (Point &p : q) {
+				p = rotate(p, sign * opening);
+				p.x += root.x;
+				p.y += root.y;
+				p = rotate(p, config.rotation);
+			}
+			result[2 * side + part] = q;
+		}
+	}
+	return result;
+}
+// Return actual motor travel, not commanded travel. End stops and a held object stall the encoder.
+inline double advance(double &opening, double motorDegrees, const Configuration &config, bool holding)
+{
+	if (!config.enabled || !config.valid() || !std::isfinite(motorDegrees) || (holding && motorDegrees < 0))
+		return 0;
+	const double old = opening;
+	opening = std::max(0.0, std::min(maximumOpening, opening + motorDegrees * maximumOpening / config.travel));
+	return (opening - old) * config.travel / maximumOpening;
+}
+}
+}
+}
