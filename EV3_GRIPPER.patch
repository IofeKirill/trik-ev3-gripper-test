diff --git a/qrtest/ev3Gripper/physicsTests.cpp b/qrtest/ev3Gripper/physicsTests.cpp
new file mode 100644
index 0000000..5d65a2e
--- /dev/null
+++ b/qrtest/ev3Gripper/physicsTests.cpp
@@ -0,0 +1,157 @@
+#ifdef NDEBUG
+#	undef NDEBUG
+#endif
+#include "box2DGripper.h"
+#include <cassert>
+#include <cmath>
+#include <iostream>
+using namespace twoDModel::model;
+using twoDModel::model::physics::parts::Box2DGripper;
+struct World {
+	b2WorldId id;
+	b2BodyId robot;
+	World()
+	{
+		auto def = b2DefaultWorldDef();
+		def.gravity = {0, 0};
+		id = b2CreateWorld(&def);
+		auto body = b2DefaultBodyDef();
+		body.type = b2_dynamicBody;
+		robot = b2CreateBody(id, &body);
+		auto shape = b2DefaultShapeDef();
+		shape.density = 1;
+		auto polygon = b2MakeBox(.5f, .5f);
+		b2CreatePolygonShape(robot, &shape, &polygon);
+	}
+	~World()
+	{
+		b2DestroyWorld(id);
+	}
+	b2BodyId ball(float x, float y, float radius, b2BodyType type = b2_dynamicBody)
+	{
+		auto def = b2DefaultBodyDef();
+		def.type = type;
+		def.position = {x, y};
+		auto body = b2CreateBody(id, &def);
+		auto shape = b2DefaultShapeDef();
+		shape.density = 1;
+		auto circle = b2Circle {{0, 0}, radius};
+		b2CreateCircleShape(body, &shape, &circle);
+		return body;
+	}
+	void step()
+	{
+		b2World_Step(id, 1.f / 120, 4);
+	}
+};
+int main()
+{
+	gripper::Configuration config;
+	config.enabled = true;
+	assert(config.valid());
+	double opening = 35;
+	assert(gripper::advance(opening, 360, config, false) > 0 && opening == 55);
+	assert(gripper::advance(opening, -360, config, false) < 0 && opening == 0);
+	assert(gripper::advance(opening, -30, config, false) == 0);
+	opening = 20;
+	assert(gripper::advance(opening, -30, config, true) == 0 && opening == 20);
+	assert(gripper::advance(opening, 30, config, true) > 0);
+	config.port = 5;
+	assert(!config.valid());
+	config.port = 0;
+	config.length = NAN;
+	assert(!config.valid());
+	config.length = .7;
+	auto geometry = gripper::geometry(config, 0, 1, 1);
+	auto rotated = config;
+	rotated.rotation = 90;
+	auto turned = gripper::geometry(rotated, 0, 1, 1);
+	assert(std::abs(turned[0][0].x + geometry[0][0].y) < 1e-9);
+	{
+		World world;
+		Box2DGripper grip(world.id, world.robot);
+		grip.setGeometry(geometry, true);
+		auto ball = world.ball(.90f, 0, .17f);
+		world.step();
+		grip.tryCapture({ball}, false);
+		assert(!grip.holding());
+		grip.tryCapture({ball}, true);
+		assert(grip.holding());
+		const auto before = b2Body_GetPosition(ball);
+		for (int i = 0; i < 30; ++i) {
+			b2Body_SetLinearVelocity(world.robot, {.4f, 0});
+			world.step();
+		}
+		assert(b2Body_GetPosition(ball).x > before.x + .05f);
+		grip.release();
+		assert(!grip.holding());
+		assert(b2Body_GetJointCount(ball) == 0);
+	}
+	{
+		World world;
+		Box2DGripper grip(world.id, world.robot);
+		grip.setGeometry(geometry, true);
+		auto oneSide = world.ball(.9f, .28f, .1f);
+		world.step();
+		grip.tryCapture({oneSide}, true);
+		assert(!grip.holding());
+	}
+	{
+		World world;
+		Box2DGripper grip(world.id, world.robot);
+		grip.setGeometry(geometry, true);
+		auto wall = world.ball(.9f, 0, .17f, b2_staticBody);
+		world.step();
+		grip.tryCapture({wall}, true);
+		assert(!grip.holding());
+	}
+	{
+		World world;
+		Box2DGripper grip(world.id, world.robot);
+		grip.setGeometry(geometry, true);
+		auto ball = world.ball(.9f, 0, .17f);
+		world.step();
+		grip.tryCapture({ball}, true);
+		assert(grip.holding());
+		b2DestroyBody(ball);
+		assert(!grip.holding());
+		grip.release();
+		grip.setGeometry(geometry, false);
+	}
+
+	{
+		World world;
+		Box2DGripper grip(world.id, world.robot);
+		auto payload = world.ball(.9f, .02f, .17f);
+		double angle = 35;
+		for (int i = 0; i < 200 && !grip.holding(); ++i) {
+			gripper::advance(angle, -2, config, grip.holding());
+			grip.setGeometry(gripper::geometry(config, angle, 1, 1), true);
+			world.step();
+			grip.tryCapture({payload}, true);
+		}
+		assert(grip.holding());
+		const double stalled = angle;
+		assert(gripper::advance(angle, -90, config, grip.holding()) == 0 && angle == stalled);
+		auto wallDef = b2DefaultBodyDef();
+		wallDef.position = {1.6f, 0};
+		auto wall = b2CreateBody(world.id, &wallDef);
+		auto wallShape = b2DefaultShapeDef();
+		auto wallPolygon = b2MakeBox(.05f, 1.f);
+		b2CreatePolygonShape(wall, &wallShape, &wallPolygon);
+		for (int i = 0; i < 300; ++i) {
+			b2Body_SetLinearVelocity(world.robot, {.5f, 0});
+			world.step();
+		}
+		assert(b2Body_GetPosition(world.robot).x < .5f);
+		assert(b2Body_GetPosition(payload).x + .17f < 1.62f);
+		grip.release();
+		gripper::advance(angle, 180, config, false);
+		grip.setGeometry(gripper::geometry(config, angle, 1, 1), true);
+		world.step();
+		grip.tryCapture({payload}, false);
+		assert(!grip.holding());
+	}
+	std::cout << "PASS: motor end stops, stall, opening, geometry, two-sided capture, carry, release, one-sided "
+		     "rejection, wall rejection, payload deletion\n";
+}
diff --git a/qrtest/ev3Gripper/serializationTests.cpp b/qrtest/ev3Gripper/serializationTests.cpp
new file mode 100644
index 0000000..c4f0737
--- /dev/null
+++ b/qrtest/ev3Gripper/serializationTests.cpp
@@ -0,0 +1,42 @@
+/* EV3 gripper prototype tests, Apache-2.0. */
+#ifdef NDEBUG
+#	undef NDEBUG
+#endif
+#include "twoDModel/engine/model/gripperSerialization.h"
+#include <cassert>
+#include <iostream>
+using namespace twoDModel::model::gripper;
+int main()
+{
+	QDomDocument doc;
+	assert(doc.setContent(QString("<robot/>")));
+	auto root = doc.documentElement();
+	assert(!deserialize(root).enabled);
+	Configuration expected;
+	expected.enabled = true;
+	expected.port = 3;
+	expected.x = .6;
+	expected.y = -.2;
+	expected.rotation = 90;
+	expected.length = 1.2;
+	expected.initialOpening = 12;
+	expected.travel = 360;
+	serialize(expected, root);
+	QDomDocument saved;
+	assert(saved.setContent(doc.toByteArray()));
+	auto value = deserialize(saved.documentElement());
+	assert(value.enabled && value.port == 3 && value.rotation == 90 && value.length == 1.2 && value.travel == 360
+	        && value.initialOpening == 12);
+	for (const auto &bad : {QString("<robot><gripper enabled='true' port=''/></robot>"),
+		     QString("<robot><gripper enabled='true' port='BLAH'/></robot>"),
+		     QString("<robot><gripper enabled='true' length='nan'/></robot>"),
+		     QString("<robot><gripper enabled='true' x='Infinity'/></robot>"),
+		     QString("<robot><gripper enabled='true' opening='-1'/></robot>"),
+		     QString("<robot><gripper enabled='true' travel='0'/></robot>")}) {
+		QDomDocument invalid;
+		assert(invalid.setContent(bad));
+		assert(!deserialize(invalid.documentElement()).enabled);
+	}
+	std::cout << "PASS: old field compatibility, XML roundtrip, invalid/empty port, NaN, infinity, end-stop and "
+		     "travel validation\n";
+}
