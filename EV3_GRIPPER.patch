@@ -0,0 +1,199 @@
+/* EV3 mechanisms. Apache-2.0. Moving links are real rigid bodies with motorized hinges. */
+#include "box2DGripper.h"
+#include <algorithm>
+using namespace twoDModel::model::physics::parts;
+namespace g = twoDModel::model::gripper;
+namespace {
+b2ShapeId polygon(b2BodyId body, const g::Polygon &poly, bool moving)
+{
+	std::vector<b2Vec2> points;
+	for (auto p : poly)
+		points.push_back({static_cast<float>(p.x), static_cast<float>(-p.y)});
+	const auto hull = b2ComputeHull(points.data(), static_cast<int>(points.size()));
+	if (hull.count < 3)
+		return b2_nullShapeId;
+	const auto shape = b2MakePolygon(&hull, 0);
+	auto def = b2DefaultShapeDef();
+	double area = 0;
+	for (size_t i = 0; i < poly.size(); ++i) {
+		auto a = poly[i], b = poly[(i + 1) % poly.size()];
+		area += a.x * b.y - b.x * a.y;
+	}
+	def.density = moving ? static_cast<float>(.02 / std::max(1e-12, std::abs(area) / 2)) : 0;
+	def.material.friction = .8f;
+	def.material.restitution = 0;
+	def.filter.groupIndex = -123;
+	return b2CreatePolygonShape(body, &def, &shape);
+}
+}
+Box2DGripper::~Box2DGripper()
+{
+	clear();
+}
+void Box2DGripper::clear()
+{
+	release();
+	for (auto &j : mJoints) {
+		if (b2Joint_IsValid(j))
+			b2DestroyJoint(j);
+		j = b2_nullJointId;
+	}
+	for (auto &b : mBodies) {
+		if (b2Body_IsValid(b))
+			b2DestroyBody(b);
+		b = b2_nullBodyId;
+	}
+	for (auto s : mFixed)
+		if (b2Shape_IsValid(s))
+			b2DestroyShape(s, false);
+	mFixed.clear();
+	for (auto &v : mShapes)
+		v.clear();
+}
+bool Box2DGripper::holding() const
+{
+	return b2Joint_IsValid(mGripJoint) && b2Body_IsValid(mHeldBody);
+}
+void Box2DGripper::release()
+{
+	if (b2Joint_IsValid(mGripJoint))
+		b2DestroyJoint(mGripJoint);
+	mGripJoint = b2_nullJointId;
+	mHeldBody = b2_nullBodyId;
+}
+void Box2DGripper::configure(const g::Configuration &c, double initial, double width, double height)
+{
+	clear();
+	mConfig = c;
+	mOpening = {{initial, initial}};
+	mLast = {{0, 0}};
+	if (!c.enabled || !c.valid())
+		return;
+	const auto geometry = g::geometry(c, initial, width, height);
+	for (const auto &p : g::baseGeometry(c, width, height))
+		mFixed.push_back(polygon(mRobot, p, false));
+	if (!c.motorized()) {
+		for (const auto &p : geometry)
+			mFixed.push_back(polygon(mRobot, p, false));
+		return;
+	}
+	const int count = c.kind == g::Gripper ? 2 : 1;
+	for (int side = 0; side < count; ++side) {
+		auto def = b2DefaultBodyDef();
+		def.type = b2_dynamicBody;
+		def.position = b2Body_GetPosition(mRobot);
+		def.rotation = b2Body_GetRotation(mRobot);
+		def.isBullet = true;
+		def.enableSleep = false;
+		mBodies[side] = b2CreateBody(mWorld, &def);
+		if (c.kind == g::Gripper)
+			mShapes[side].push_back(polygon(mBodies[side], geometry[side], true));
+		else
+			for (const auto &p : geometry)
+				mShapes[side].push_back(polygon(mBodies[side], p, true));
+		auto joint = b2DefaultRevoluteJointDef();
+		joint.base.bodyIdA = mRobot;
+		joint.base.bodyIdB = mBodies[side];
+		joint.base.collideConnected = false;
+		const auto p = g::placed(c.kind == g::Gripper ? g::Point {1, side ? 5.5 : -5.5} : g::Point {0, 0}, c,
+			width, height);
+		joint.base.localFrameA.p = {static_cast<float>(p.x), static_cast<float>(-p.y)};
+		joint.base.localFrameB.p = joint.base.localFrameA.p;
+		joint.enableMotor = true;
+		joint.maxMotorTorque =
+			static_cast<float>((c.kind == g::Gripper ? .20 : .35) * (width / .18) * (width / .18));
+		if (c.kind == g::Gripper) {
+			const double sign = side ? 1 : -1;
+			const double a = -sign * (g::minimumOpening - initial) * g::radians,
+				     b = -sign * (c.maxOpening / 2 - initial) * g::radians;
+			joint.enableLimit = true;
+			joint.lowerAngle = static_cast<float>(std::min(a, b));
+			joint.upperAngle = static_cast<float>(std::max(a, b));
+		}
+		mJoints[side] = b2CreateRevoluteJoint(mWorld, &joint);
+	}
+}
+void Box2DGripper::drive(double degrees)
+{
+	if (degrees > 0)
+		release();
+	const double speed = std::max(-20.0, std::min(20.0, degrees * g::motorRatio(mConfig) * g::radians));
+	for (int side = 0; side < 2; ++side)
+		if (b2Joint_IsValid(mJoints[side])) {
+			const double sign = mConfig.kind == g::Gripper ? (side ? 1 : -1) : 1;
+			double controlled = speed;
+			if (mConfig.kind == g::Gripper) {
+				// Brake before a mechanical stop instead of continuously driving into the limit solver.
+				controlled = std::max((g::minimumOpening - mOpening[side]) * g::radians / .08,
+					std::min((mConfig.maxOpening / 2 - mOpening[side]) * g::radians / .08,
+						controlled));
+			}
+			b2RevoluteJoint_SetMotorSpeed(mJoints[side],
+				static_cast<float>(-sign * (holding() && degrees < 0 ? 0 : controlled)));
+			b2Body_SetAwake(mBodies[side], true);
+		}
+}
+double Box2DGripper::sample()
+{
+	double travelled = 0;
+	int count = 0;
+	for (int side = 0; side < 2; ++side)
+		if (b2Joint_IsValid(mJoints[side])) {
+			const double angle = b2RevoluteJoint_GetAngle(mJoints[side]);
+			double delta = angle - mLast[side];
+			while (delta > 3.141592653589793)
+				delta -= 2 * 3.141592653589793;
+			while (delta < -3.141592653589793)
+				delta += 2 * 3.141592653589793;
+			mLast[side] = angle;
+			const double sign = mConfig.kind == g::Gripper ? (side ? 1 : -1) : 1;
+			delta = -sign * delta / g::radians;
+			mOpening[side] += delta;
+			travelled += delta / g::motorRatio(mConfig);
+			++count;
+		}
+	if (mConfig.kind == g::Kicker)
+		mOpening[1] = mOpening[0];
+	return count ? travelled / count : 0;
+}
+bool Box2DGripper::touches(b2BodyId body, int side) const
+{
+	for (auto shape : mShapes[side])
+		if (b2Shape_IsValid(shape)) {
+			std::vector<b2ContactData> contacts(b2Shape_GetContactCapacity(shape));
+			const int count =
+				b2Shape_GetContactData(shape, contacts.data(), static_cast<int>(contacts.size()));
+			for (int j = 0; j < count; ++j) {
+				const auto &c = contacts[j];
+				const auto other = B2_ID_EQUALS(c.shapeIdA, shape) ? c.shapeIdB : c.shapeIdA;
+				bool touching = false;
+				for (int k = 0; k < c.manifold.pointCount; ++k)
+					touching = touching || c.manifold.points[k].separation <= .001f;
+				if (touching && B2_ID_EQUALS(b2Shape_GetBody(other), body))
+					return true;
+			}
+		}
+	return false;
+}
+void Box2DGripper::tryCapture(const std::vector<b2BodyId> &objects, bool closing)
+{
+	if (mConfig.kind != g::Gripper || holding() || !closing)
+		return;
+	for (auto body : objects) {
+		if (!b2Body_IsValid(body) || b2Body_GetType(body) != b2_dynamicBody || !b2Body_IsEnabled(body)
+		        || b2Body_GetJointCount(body) > 0 || !touches(body, 0) || !touches(body, 1))
+			continue;
+		auto joint = b2DefaultWeldJointDef();
+		joint.base.bodyIdA = mRobot;
+		joint.base.bodyIdB = body;
+		joint.base.localFrameA.p = b2Body_GetLocalPoint(mRobot, b2Body_GetPosition(body));
+		joint.base.localFrameA.q = b2MakeRot(
+			b2Rot_GetAngle(b2Body_GetRotation(body)) - b2Rot_GetAngle(b2Body_GetRotation(mRobot)));
+		joint.base.localFrameB.p = {0, 0};
+		joint.base.localFrameB.q = b2MakeRot(0);
+		joint.base.collideConnected = false;
+		mGripJoint = b2CreateWeldJoint(mWorld, &joint);
+		mHeldBody = body;
+		return;
+	}
+}
