+void Box2DRobot::updateGripper(qreal seconds)
+{
+	if (mGripperRevision != mModel->gripperRevision()) {
+		mGripper->release();
+		mGripperRevision = mModel->gripperRevision();
+	}
+	if (mModel->gripperPower() > 0 || !mModel->onTheGround())
+		mGripper->release();
+	mModel->advanceGripper(seconds, mGripper->holding());
+	const auto size = mModel->parameters()->size();
+	auto geometry = twoDModel::model::gripper::geometry(mModel->gripperConfiguration(), mModel->gripperOpening(),
+		size.width(), size.height());
+	for (auto &quad : geometry)
+		for (auto &point : quad) {
