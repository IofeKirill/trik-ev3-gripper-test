+/* EV3 mechanisms, Apache-2.0. Geometry is shared by rendering and Box2D. */
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <vector>
+namespace twoDModel {
+namespace model {
+namespace gripper {
+struct Point {
+	double x, y;
+};
+using Quad = std::array<Point, 4>;
+using Polygon = std::vector<Point>;
+using Geometry = std::vector<Polygon>;
+enum Kind { Gripper = 0, Kicker = 1, Small = 2, Large = 3, Narrow = 4, Straight = 5 };
+constexpr double radians = 3.14159265358979323846 / 180;
+constexpr double minimumOpening = -35;
+constexpr double maximumOpening = 55; // Legacy file compatibility.
+struct Configuration {
+	bool enabled = false;
+	int port = 0, kind = Gripper, kickerLength = 0;
+	double x = .48, y = 0, rotation = 0, length = .70;
+	double initialOpening = 25, travel = 180, maxOpening = 50;
+	bool motorized() const
+	{
+		return kind == Gripper || kind == Kicker;
+	}
+	bool valid() const
+	{
+		return port >= 0 && port < 4 && kind >= Gripper && kind <= Straight && kickerLength >= 0
+		       && kickerLength < 4 && std::isfinite(x) && std::abs(x) <= 4 && std::isfinite(y)
+		       && std::abs(y) <= 4 && std::isfinite(rotation) && std::abs(rotation) <= 360
+		       && std::isfinite(length) && length >= .2 && length <= 2 && std::isfinite(maxOpening)
+		       && maxOpening >= 0 && maxOpening <= 180 && std::isfinite(initialOpening) && initialOpening >= 0
+		       && initialOpening <= 360 && std::isfinite(travel) && travel >= 30 && travel <= 1440;
+	}
+};
+inline Point rotate(Point p, double angle)
+{
+	const double c = std::cos(angle * radians), s = std::sin(angle * radians);
+	return {c * p.x - s * p.y, s * p.x + c * p.y};
+}
+inline Polygon beam(Point a, Point b, double thickness = 1)
+{
+	const auto angle = std::atan2(b.y - a.y, b.x - a.x) / radians;
+	const auto axial = rotate({thickness / 2, 0}, angle);
+	a.x -= axial.x;
+	a.y -= axial.y;
+	b.x += axial.x;
+	b.y += axial.y;
+	const auto d = rotate({0, thickness / 2}, angle);
+	return {{a.x + d.x, a.y + d.y}, {b.x + d.x, b.y + d.y}, {b.x - d.x, b.y - d.y}, {a.x - d.x, a.y - d.y}};
+}
+inline Geometry fixedGeometry(int kind)
+{
+	switch (kind) {
+	case 2:
+		return {{{-0.456790123457, 7.11111111111}, {-0.456790123457, -7.17283950617},
+				{0.58024691358, -7.17283950617}, {0.58024691358, 7.11111111111}},
+			{{1.71604938272, 8.88888888889}, {1.30864197531, 8.74074074074},
+				{-0.345679012346, 7.41975308642}, {0.283950617284, 6.71604938272},
+				{1.8024691358, 7.85185185185}, {2.13580246914, 8.22222222222},
+				{2.06172839506, 8.67901234568}},
+			{{0.283950617284, -6.69135802469}, {-0.345679012346, -7.33333333333},
+				{1.32098765432, -8.69135802469}, {1.71604938272, -8.87654320988},
+				{2.06172839506, -8.66666666667}, {2.14814814815, -8.20987654321}}};
+	case 3:
+		return {{{-0.495552731893, 6.98856416773}, {-0.495552731893, -6.97585768742},
+				{0.533672172808, -6.97585768742}, {0.533672172808, 6.98856416773}},
+			{{1.99491740788, 9.59339263024}, {-0.355781448539, 7.34434561626},
+				{0.368487928844, 6.62007623888}, {2.22363405337, 8.38627700127}},
+			{{1.96950444727, 9.59339263024}, {1.96950444727, 8.37357052097}, {3.97712833545, 8.37357052097},
+				{4.3710292249, 8.56416772554}, {4.53621346887, 9.12325285896},
+				{4.29479034307, 9.52986022872}, {3.96442185515, 9.59339263024}},
+			{{0.368487928844, -6.59466327827}, {-0.355781448539, -7.33163913596},
+				{1.99491740788, -9.60609911055}, {2.23634053367, -8.32274459975}},
+			{{1.96950444727, -8.32274459975}, {1.96950444727, -9.60609911055},
+				{3.96442185515, -9.60609911055}, {4.29479034307, -9.51715374841},
+				{4.53621346887, -9.12325285896}, {4.3710292249, -8.56416772554},
+				{3.97712833545, -8.32274459975}}};
+	case 4:
+		return {{{-0.545454545455, 3.06220095694}, {-0.545454545455, -3.004784689},
+				{0.526315789474, -3.004784689}, {0.526315789474, 3.06220095694}},
+			{{4.87081339713, 7.22488038278}, {4.55502392344, 7.1961722488},
+				{-0.421052631579, 3.36842105263}, {0.239234449761, 2.53588516746},
+				{5.03349282297, 6.34449760766}, {5.18660287081, 6.67942583732},
+				{5.11961722488, 7.02392344498}},
+			{{0.239234449761, -2.53588516746}, {-0.421052631579, -3.38755980861},
+				{4.55502392344, -7.16746411483}, {4.87081339713, -7.20574162679},
+				{5.11961722488, -7.01435406699}, {5.18660287081, -6.66028708134},
+				{5.03349282297, -6.33492822967}}};
+	case 5:
+		return {{{4.4375, -11.825}, {4.8, -11.6375}, {4.925, -11.2875}, {4.925, 2.6875}, {4.7875, 3.05},
+				{4.425, 3.2125}, {4.075, 3.075}, {3.875, 2.7125}, {3.875, -11.3125},
+				{4.0625, -11.6625}},
+			{{3.9625, -3.55}, {3.95, -2.5125}, {0.2, 0.5}, {-0.225, 0.5125}, {-0.5375, 0.1875},
+				{-0.4375, -0.25}}};
+	default:
+		return {};
+	}
+}
+inline std::vector<Point> kickerPoints(int length)
+{
+	switch (length) {
+	case 0:
+		return {{0, 0}, {6, 0}, {7.29891304348, 1.59782608696}};
+	case 1:
+		return {{0, 0}, {6, 0}, {7.83333333333, 1.96666666667}, {7.83333333333, 3.94}};
+	case 2:
+		return {{0, 0}, {10.0869565217, 0}, {12.1739130435, 2.04347826087}, {12.1739130435, 4.04347826087}};
+	case 3:
+		return {{0, 0}, {14, 0}, {16.1, 2}, {16.1, 4.05}};
+	default:
+		return {};
+	}
+}
+inline Point placed(Point p, const Configuration &c, double width, double height)
+{
+	p = rotate({p.x * width / 18, p.y * width / 18}, c.rotation);
+	return {p.x + c.x * width, p.y + c.y * height};
+}
+inline double cross(Point a, Point b, Point c)
+{
+	return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
+}
+inline Geometry convexParts(Polygon p)
+{
+	double area = 0;
+	for (size_t i = 0; i < p.size(); ++i) {
+		auto a = p[i], b = p[(i + 1) % p.size()];
+		area += a.x * b.y - b.x * a.y;
+	}
+	const double sign = area >= 0 ? 1 : -1;
+	bool convex = p.size() <= 8;
+	for (size_t i = 0; convex && i < p.size(); ++i)
+		convex = sign * cross(p[i], p[(i + 1) % p.size()], p[(i + 2) % p.size()]) >= -1e-10;
+	if (convex)
+		return {p};
+	Geometry result;
+	while (p.size() > 3) {
+		bool found = false;
+		for (size_t i = 0; i < p.size(); ++i) {
+			const size_t prev = (i + p.size() - 1) % p.size(), next = (i + 1) % p.size();
+			const Point a = p[prev], b = p[i], c = p[next];
+			if (sign * cross(a, b, c) <= 1e-10)
+				continue;
+			bool contains = false;
+			for (size_t j = 0; j < p.size(); ++j)
+				if (j != prev && j != i && j != next) {
+					auto q = p[j];
+					if (sign * cross(a, b, q) >= -1e-10 && sign * cross(b, c, q) >= -1e-10
+					        && sign * cross(c, a, q) >= -1e-10) {
+						contains = true;
+						break;
+					}
+				}
+			if (contains)
+				continue;
+			result.push_back({a, b, c});
+			p.erase(p.begin() + static_cast<int>(i));
+			found = true;
+			break;
+		}
+		if (!found)
+			return {}; // Refuse malformed input instead of silently filling its concavities.
+	}
+	if (p.size() == 3)
+		result.push_back(p);
+	return result;
+}
+
+inline Geometry geometry(const Configuration &c, double opening, double width, double height,
+	double secondOpening = 1e100)
+{
+	Geometry result;
+	if (c.kind == Gripper) {
+		if (secondOpening == 1e100)
+			secondOpening = opening;
+		for (int side = 0; side < 2; ++side) {
+			const double sign = side ? 1 : -1, a = side ? secondOpening : opening;
+			auto poly = beam({0, 0}, {8, 0});
+			for (auto &p : poly) {
+				p = rotate(p, sign * a);
+				p.x += 1;
+				p.y += sign * 5.5;
+			}
+			result.push_back(poly);
+		}
+	} else if (c.kind == Kicker) {
+		const auto points = kickerPoints(c.kickerLength);
+		for (size_t i = 1; i < points.size(); ++i) {
+			auto poly = beam(points[i - 1], points[i]);
+			for (auto &p : poly)
+				p = rotate(p, opening);
+			result.push_back(poly);
+		}
+	} else
+		for (const auto &poly : fixedGeometry(c.kind)) {
+			const auto pieces = convexParts(poly);
+			result.insert(result.end(), pieces.begin(), pieces.end());
+		}
+	for (auto &poly : result)
+		for (auto &p : poly)
+			p = placed(p, c, width, height);
+	return result;
+}
+inline Geometry baseGeometry(const Configuration &c, double width, double height)
+{
+	Geometry result;
+	if (c.motorized())
+		result.push_back({{-3, -2}, {2, -2}, {2, 2}, {-3, 2}});
+	if (c.kind == Gripper)
+		result.push_back({{.1, -6}, {1.1, -6}, {1.1, 6}, {.1, 6}});
+	for (auto &poly : result)
+		for (auto &p : poly)
+			p = placed(p, c, width, height);
+	return result;
+}
+inline double motorRatio(const Configuration &c)
+{
+	return c.kind == Kicker ? 1 : (c.maxOpening / 2 - minimumOpening) / c.travel;
+}
+inline double advance(double &opening, double degrees, const Configuration &c, bool holding)
+{
+	if (!c.enabled || !c.motorized() || !c.valid() || !std::isfinite(degrees) || (holding && degrees < 0))
+		return 0;
+	const double before = opening;
+	opening += degrees * motorRatio(c);
+	if (c.kind == Gripper)
+		opening = std::max(minimumOpening, std::min(c.maxOpening / 2, opening));
+	return (opening - before) / motorRatio(c);
+}
+}
+}
+}
