+bool RobotModel::configureGripper(const gripper::Configuration &configuration)
+{
+	if (!configuration.valid() || (configuration.enabled && !info().supportsGripper()))
+		return false;
+	const PortInfo port(QString(QChar('A' + configuration.port)), output);
+	if (configuration.enabled && configuration.motorized()
+	        && (getPortInfoOnWheel(left).name() == port.name() || getPortInfoOnWheel(right).name() == port.name()))
+		return false;
+	// Stop the previously assigned motor before replacing the mechanism.
+	for (auto it = mMotors.begin(); it != mMotors.end(); ++it)
+		if (mGripper.enabled && mGripper.motorized() && it.key().name() == QString(QChar('A' + mGripper.port)))
+			it.value()->speed = 0;
+	mGripper = configuration;
+	mGripperOpening = mGripper.kind == gripper::Gripper ? mGripper.maxOpening / 2 : mGripper.initialOpening;
+	mJawOpenings = {{mGripperOpening, mGripperOpening}};
+	++mGripperRevision;
+	if (mGripper.enabled)
+		mSettings->setRealisticPhysics(true);
+	Q_EMIT gripperChanged();
+	return true;
+}
+
+int RobotModel::gripperPower() const
+{
+	if (!mGripper.enabled || !mGripper.motorized() || !onTheGround())
+		return 0;
+	for (auto it = mMotors.cbegin(); it != mMotors.cend(); ++it)
+		if (it.key().name() == QString(QChar('A' + mGripper.port)))
+			return it.value()->speed;
+	return 0;
+}
+
+void RobotModel::resetGripper()
+{
+	mGripperOpening = mGripper.kind == gripper::Gripper ? mGripper.maxOpening / 2 : mGripper.initialOpening;
+	mJawOpenings = {{mGripperOpening, mGripperOpening}};
+	++mGripperRevision;
+	Q_EMIT gripperChanged();
+}
+double RobotModel::gripperMotorVelocity() const
+{
+	return gripperPower() * parameters()->onePercentAngularVelocity() * 1000;
+}
+void RobotModel::recordGripperMotion(double first, double second, double actual)
+{
+	if (!qIsFinite(first) || !qIsFinite(second) || !qIsFinite(actual))
+		return;
+	mJawOpenings = {{first, second}};
+	mGripperOpening = (first + second) / 2;
+	if (mGripper.enabled && mGripper.motorized())
+		for (auto it = mMotors.begin(); it != mMotors.end(); ++it) {
+			if (it.key().name() != QString(QChar('A' + mGripper.port)))
+				continue;
+			auto &motor = *it.value();
+			mTurnoverEngines[mMotorToEncoderPortMap[it.key()]] += actual;
+			if (motor.isUsed && motor.activeTimeType == DoByLimit
+			        && std::abs(mTurnoverEngines[mMotorToEncoderPortMap[it.key()]])
+			                   >= std::abs(motor.degrees)) {
+				motor.speed = 0;
+				motor.activeTimeType = End;
+			}
+			break;
+		}
+	Q_EMIT gripperChanged();
+}
+void RobotModel::advanceGripper(qreal seconds, bool holding)
+{
+	if (!mGripper.enabled || !mGripper.motorized() || !onTheGround() || !qIsFinite(seconds) || seconds <= 0)
+		return;
+	double opening = mGripperOpening;
+	const double actual = gripper::advance(opening, gripperMotorVelocity() * seconds, mGripper, holding);
+	recordGripperMotion(opening, opening, actual);
+}
+
+void RobotModel::serializeGripper(QDomElement &robot) const
+{
+	if (info().supportsGripper())
+		gripper::serialize(mGripper, robot);
+}
+
+void RobotModel::deserializeGripper(const QDomElement &robot)
+{
+	auto configuration = gripper::deserialize(robot);
+	if (!configureGripper(configuration)) {
+		configuration.enabled = false;
+		configureGripper(configuration);
+	}
+}
