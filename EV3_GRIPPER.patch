+void Box2DRobot::updateGripper(qreal seconds)
+{
+	Q_UNUSED(seconds);
+	if (mGripperRevision != mModel->gripperRevision()) {
+		mGripperRevision = mModel->gripperRevision();
+		auto c = mModel->gripperConfiguration();
+		c.enabled = c.enabled && mModel->onTheGround();
+		const auto size = mModel->parameters()->size();
+		mGripper->configure(c, mModel->gripperOpening(), mEngine->pxToM(size.width()),
+			mEngine->pxToM(size.height()));
+	}
+	if (!mModel->onTheGround()) {
+		mGripper->clear();
+		mGripperRevision = ~0u;
+		return;
+	}
+	mGripper->drive(mModel->gripperMotorVelocity());
+}
+void Box2DRobot::captureWithGripper(const std::vector<b2BodyId> &items)
+{
+	const auto &c = mModel->gripperConfiguration();
+	if (!c.enabled || !c.motorized() || !mModel->onTheGround())
+		return;
+	const double actual = mGripper->sample();
+	mModel->recordGripperMotion(mGripper->opening(0), mGripper->opening(1), actual);
+	mGripper->tryCapture(items, c.kind == twoDModel::model::gripper::Gripper && mModel->gripperPower() < 0);
+}
