@@ -0,0 +1,56 @@
+/* EV3 gripper prototype, 2026. Apache-2.0. */
+#pragma once
+#include <QDomElement>
+#include "gripperGeometry.h"
+namespace twoDModel {
+namespace model {
+namespace gripper {
+inline void serialize(const Configuration &config, QDomElement &robot)
+{
+	auto element = robot.ownerDocument().createElement("gripper");
+	element.setAttribute("enabled", config.enabled ? "true" : "false");
+	element.setAttribute("port", QString(QChar('A' + config.port)));
+	element.setAttribute("x", config.x);
+	element.setAttribute("y", config.y);
+	element.setAttribute("rotation", config.rotation);
+	element.setAttribute("length", config.length);
+	element.setAttribute("opening", config.initialOpening);
+	element.setAttribute("travel", config.travel);
+	element.setAttribute("kind", config.kind);
+	element.setAttribute("kickerLength", config.kickerLength);
+	element.setAttribute("maxOpening", config.maxOpening);
+	robot.appendChild(element);
+}
+inline Configuration deserialize(const QDomElement &robot)
+{
+	Configuration config;
+	const auto element = robot.firstChildElement("gripper");
+	if (element.isNull())
+		return config;
+	config.enabled = element.attribute("enabled") == "true";
+	const auto name = element.attribute("port", "A");
+	config.port = name.size() == 1 ? name.at(0).unicode() - QChar('A').unicode() : -1;
+	bool valid = true;
+	auto number = [&](const QString &name, double fallback) {
+		bool ok = false;
+		const auto value = element.attribute(name, QString::number(fallback)).toDouble(&ok);
+		valid = valid && ok && std::isfinite(value);
+		return value;
+	};
+	config.x = number("x", .48);
+	config.y = number("y", 0);
+	config.rotation = number("rotation", 0);
+	config.length = number("length", .70);
+	config.initialOpening = number("opening", 25);
+	config.travel = number("travel", 180);
+	const double kind = number("kind", 0), length = number("kickerLength", 0);
+	valid = valid && kind == std::floor(kind) && kind >= 0 && kind <= 5 && length == std::floor(length)
+	        && length >= 0 && length < 4;
+	config.kind = valid ? static_cast<int>(kind) : 0;
+	config.kickerLength = valid ? static_cast<int>(length) : 0;
+	config.maxOpening = number("maxOpening", element.hasAttribute("kind") ? 50 : 110);
+	return valid && config.valid() ? config : Configuration();
+}
+}
+}
+}
